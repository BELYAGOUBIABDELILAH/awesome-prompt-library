{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BELYAGOUBIABDELILAH/open-prompt-library/schemas/source.schema.json",
  "title": "Open Prompt Library source registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "display_name", "url", "author", "license", "redistribution_status", "notes"],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "author": {
      "type": ["string", "null"]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "redistribution_status": {
      "type": "string",
      "enum": ["needs-review", "verified", "restricted", "unknown"]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BELYAGOUBIABDELILAH/open-prompt-library/schemas/prompt.schema.json",
  "title": "Open Prompt Library canonical prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "legacy_slug_original",
    "legacy_slugs",
    "legacy_slugs_raw",
    "title",
    "alternate_titles",
    "summary",
    "prompt",
    "category",
    "category_folder",
    "tags",
    "language",
    "prompt_type",
    "variables",
    "output_format",
    "source_ids",
    "provenance_status",
    "status",
    "revision",
    "content_hash",
    "merged_from",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^opl_[a-f0-9]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "legacy_slug_original": {
      "type": "string",
      "minLength": 1
    },
    "legacy_slugs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "legacy_slugs_raw": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "alternate_titles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "category_folder": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "language": {
      "type": "string",
      "pattern": "^(unknown|[a-z]{2}(?:-[A-Z]{2})?)$"
    },
    "prompt_type": {
      "type": "string",
      "enum": ["text", "chat", "image", "multimodal", "unknown"]
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "output_format": {
      "type": "string",
      "enum": ["text", "json", "markdown", "list", "unknown"]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "provenance_status": {
      "type": "string",
      "enum": ["needs-review", "verified", "restricted", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "tested", "verified", "deprecated"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "merged_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "required", "example"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "example": {
          "type": ["string", "number", "boolean", "null"]
        }
      }
    }
  }
}
